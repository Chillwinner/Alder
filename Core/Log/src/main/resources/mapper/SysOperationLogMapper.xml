<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xddcodec.fs.log.mapper.SysOperationLogMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_operation_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="operatorId != null">operator_id,</if>
            <if test="operatorName != null">operator_name,</if>
            <if test="workspaceId != null">workspace_id,</if>
            <if test="operationType != null">operation_type,</if>
            <if test="operationName != null">operation_name,</if>
            <if test="targetType != null">target_type,</if>
            <if test="targetId != null">target_id,</if>
            <if test="targetName != null">target_name,</if>
            <if test="detail != null">detail,</if>
            <if test="operationIp != null">operation_ip,</if>
            <if test="userAgent != null">user_agent,</if>
            <if test="status != null">status,</if>
            <if test="errorMessage != null">error_message,</if>
            <if test="operationTime != null">operation_time,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="operatorId != null">#{operatorId},</if>
            <if test="operatorName != null">#{operatorName},</if>
            <if test="workspaceId != null">#{workspaceId},</if>
            <if test="operationType != null">#{operationType},</if>
            <if test="operationName != null">#{operationName},</if>
            <if test="targetType != null">#{targetType},</if>
            <if test="targetId != null">#{targetId},</if>
            <if test="targetName != null">#{targetName},</if>
            <if test="detail != null">#{detail},</if>
            <if test="operationIp != null">#{operationIp},</if>
            <if test="userAgent != null">#{userAgent},</if>
            <if test="status != null">#{status},</if>
            <if test="errorMessage != null">#{errorMessage},</if>
            <if test="operationTime != null">#{operationTime},</if>
        </trim>
    </insert>


    <select id="selectPage" resultType="com.xddcodec.fs.Log.domain.SysOperationLog">
        SELECT *
        FROM sys_operation_log
        <where>
            workspace_id = #{workspaceId}
            <if test="keyword != null and keyword != ''">
                AND (
                    operator_name LIKE '%' || #{keyword} || '%'
                    OR operator_id LIKE '%' || #{keyword} || '%'
                    OR operation_name LIKE '%' || #{keyword} || '%'
                    OR target_name LIKE '%' || #{keyword} || '%'
                    OR detail LIKE '%' || #{keyword} || '%'
                    OR operation_ip LIKE '%' || #{keyword} || '%'
                )
            </if>
            <if test="operationType != null and operationType != ''">
                AND operation_type = #{operationType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY operation_time DESC, id DESC
    </select>
</mapper>
