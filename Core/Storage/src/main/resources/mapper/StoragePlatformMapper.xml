<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xddcodec.fs.storage.mapper.StoragePlatformMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO storage_platform
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="identifier != null">identifier,</if>
            <if test="configScheme != null">config_scheme,</if>
            <if test="icon != null">icon,</if>
            <if test="link != null">link,</if>
            <if test="isDefault != null">is_default,</if>
            <if test="desc != null">"desc",</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="identifier != null">#{identifier},</if>
            <if test="configScheme != null">CAST(#{configScheme} AS json),</if>
            <if test="icon != null">#{icon},</if>
            <if test="link != null">#{link},</if>
            <if test="isDefault != null">#{isDefault},</if>
            <if test="desc != null">#{desc},</if>
        </trim>
    </insert>

    <update id="updateById">
        UPDATE storage_platform
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="identifier != null">identifier = #{identifier},</if>
            <if test="configScheme != null">config_scheme = CAST(#{configScheme} AS json),</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="link != null">link = #{link},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="desc != null">"desc" = #{desc},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
