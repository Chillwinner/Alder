<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xddcodec.fs.file.mapper.FileShareItemMapper">

    <insert id="insert">
        INSERT INTO file_share_items
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="shareId != null">share_id,</if>
            <if test="fileId != null">file_id,</if>
            created_at,
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="shareId != null">#{shareId},</if>
            <if test="fileId != null">#{fileId},</if>
            now(),
        </trim>
    </insert>

    <delete id="deleteByShareIds">
        DELETE FROM file_share_items
        WHERE share_id IN
        <foreach collection="shareIds" item="shareId" open="(" separator="," close=")">
            #{shareId}
        </foreach>
    </delete>
</mapper>
